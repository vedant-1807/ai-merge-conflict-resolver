# Copy to .env and fill in. Nested settings use "__" (e.g. LLM__FIXED_MODEL).
# Keep comments on their own lines: docker compose does not strip inline comments.
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://mergeagent:mergeagent@localhost:5432/mergeagent
REDIS_URL=redis://localhost:6379/0
WORKSPACE_ROOT=/tmp/mergeagent/workspaces

# GitHub App (see docs/github-app-setup.md)
GITHUB__APP_ID=
GITHUB__PRIVATE_KEY_PATH=./github-app.pem
GITHUB__WEBHOOK_SECRET=

# LLM gateway. Provider: anthropic
LLM__PROVIDER=anthropic
LLM__ANTHROPIC_API_KEY=
LLM__MAX_JOB_BUDGET_USD=2.00
# Uncomment to disable routing (cost baseline):
# LLM__FIXED_MODEL=claude-opus-5-5

# RAG embeddings: voyage (needs key) or hashing (offline, no key)
EMBEDDINGS__PROVIDER=hashing
EMBEDDINGS__VOYAGE_API_KEY=

# Sandbox backend: docker (isolated) or local (tests only, NOT isolated)
SANDBOX__BACKEND=docker
SANDBOX__IMAGE=mergeagent-sandbox-python:latest
# gVisor runtime, if installed:
# SANDBOX__RUNTIME=runsc
